apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ app_name }}-deployment
  namespace: {{ namespace }}
  labels:
    app: {{ app_name }}
spec:
  replicas: {{ replicas }}
  selector:
    matchLabels:
      app: {{ app_name }}
  template:
    metadata:
      labels:
        app: {{ app_name }}

    spec:
      containers:
      - name: {{ app_name }}-container
        image: {{ image_name }}
        imagePullPolicy: IfNotPresent
        ports:
        - name: backend-port
          containerPort: 8000
        - name: frontend-port
          containerPort: 8501
        resources:
          requests:
            memory: "{{ memory_request }}"
            cpu: "{{ cpu_request }}"
          limits:
            memory: "{{ memory_limit }}"
            cpu: "{{ cpu_limit }}"
        livenessProbe:
          httpGet:
            path: /health
            port: {{ container_port }}
          initialDelaySeconds: 20
          periodSeconds: 120
        readinessProbe:
          httpGet:
            path: /health
            port: {{ container_port }}
          initialDelaySeconds: 20
          periodSeconds: 120